DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=ripetizioni
POSTGRES_USER=ripetizioni
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_HOST=db
DB_PORT=5432
G1_APPROVED=0
# P0: flag di funzione (in produzione attivi per default; EXPERIMENTAL_* vietati)
FEATURE_PLANNING=1
FEATURE_PLANNING_LAB=1
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_HOST=redis
FEATURE_CALENDAR=1

# --- P1-P6: regole del centro (vedi docs/CONFIGURAZIONE.md) ---
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
RECOVERY_NOTICE_HOURS=24
PRIVACY_NOTICE_VERSION=2026-10
TUTOR_CHANGES_REQUIRE_GUARDIANS=1
PORTAL_STUDENT_CAN_REQUEST_CHANGES=0
PRIVACY_MAJORITY_OVERDUE_ACTION=REPORT
# Decisione del centro: avvisi solo nel portale (IN_APP,EMAIL per aggiungere l'email)
COMMUNICATIONS_CHANNELS=IN_APP

# --- Email (SMTP) ---
# In locale resta "sink": nessuna email parte davvero (regola del codice: invio reale
# solo con COMMUNICATIONS_ENV=production). Per attivare l'email, in produzione:
# COMMUNICATIONS_CHANNELS=IN_APP,EMAIL e i valori del blocco qui sotto.
COMMUNICATIONS_ENV=production          # senza questa riga l'invio reale è bloccato
COMMUNICATIONS_CHANNELS=IN_APP,EMAIL   # con solo IN_APP l'email resta spenta
COMMUNICATIONS_EMAIL_BACKEND=smtp
COMMUNICATIONS_EMAIL_FROM=Centro ripetizioni <no-reply@denuvo.studio>
COMMUNICATIONS_MESSAGE_ID_DOMAIN=denuvo.studio
COMMUNICATIONS_SMTP_HOST=smtp.resend.com
COMMUNICATIONS_SMTP_PORT=587           # 587 + starttls, oppure 465 + tls
COMMUNICATIONS_SMTP_SECURITY=starttls
COMMUNICATIONS_SMTP_USER=resend
COMMUNICATIONS_SMTP_PASSWORD=
