# Variabili da incollare in Dokploy -> servizio Compose -> Environment.
# Genera i segreti con: python3 scripts/dokploy-secrets.py
# Mai committare il file con i valori reali.

# --- Dominio ed email (da compilare a mano) ---
APP_DOMAIN=gestionale.tuodominio.it
EMAIL_FROM=Centro ripetizioni <no-reply@tuodominio.it>
EMAIL_DOMAIN=tuodominio.it
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Username del superuser (gestore): proposta automatica del calendario mensile.
# Lasciare vuoto al primo deploy, compilare dopo aver creato il superuser.
CENTER_ADMIN_USERNAME=

# --- Segreti (generati) ---
DJANGO_SECRET_KEY=
PG_ADMIN_PASSWORD=
PG_MIGRATOR_PASSWORD=
PG_RUNTIME_PASSWORD=
PG_READONLY_PASSWORD=
REDIS_PASSWORD=
OPS_METRICS_TOKEN=
COMMUNICATIONS_SEAL_KEYS=

# --- Opzionali (default sensati) ---
POSTGRES_DB=ripetizioni
PG_ADMIN_USER=pgadmin
DJANGO_HSTS_SECONDS=3600
GUNICORN_WORKERS=3
COMMUNICATIONS_CHANNELS=IN_APP,EMAIL
RECOVERY_NOTICE_HOURS=24
PRIVACY_NOTICE_VERSION=2026-10
LOG_LEVEL=INFO

# --- Videolezioni (v0.10, facoltative) ---
# Jitsi Meet self-hosted da compose.jitsi.yaml su un sottodominio dedicato.
# Lasciare VIDEO_PROVIDER vuoto per disattivarle.
VIDEO_PROVIDER=
VIDEO_JITSI_URL=https://meet.tuodominio.it
JITSI_JWT_APP_ID=ripetizioni
# Stesso valore anche nello stack Jitsi. Generare: openssl rand -hex 32
JITSI_JWT_APP_SECRET=
