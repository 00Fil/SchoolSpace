# Solo prova end-to-end locale (scripts/e2e-compose.sh): valori SINTETICI, nessun segreto reale.
# Stesse regole della produzione (config.settings_production): TLS verificato su DB e Redis
# con la CA locale di .e2e/, origini https, flag sperimentali spenti.
DEPLOY_ENVIRONMENT=staging
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=e2e-synthetic-7fQ2mZr9LwX4vB8nK1pT6yH3sD5gJ0cA2eU9iO4qW7xR1zN8bM
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,proxy
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443
PORTAL_BASE_URL=https://localhost:8443
POSTGRES_DB=ripetizioni
POSTGRES_USER=app_runtime
POSTGRES_PASSWORD=e2e-only-runtime
DB_HOST=db
DB_SSLMODE=verify-full
CACHE_URL=rediss://app:e2e-only-redis@redis:6380/1
CELERY_BROKER_URL=rediss://app:e2e-only-redis@redis:6380/0
OPS_METRICS_TOKEN=e2e-metrics-token
OPS_WORKER_QUEUES=solver,notifications,default
OPS_BACKUP_STATUS_FILE=/tmp/backup-status.json
