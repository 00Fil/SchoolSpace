# Variabili dello stack compose.jitsi.yaml (Dokploy -> Environment). Mai committare i valori reali.
VIDEO_JITSI_URL=https://meet.tuodominio.it
JITSI_JWT_APP_ID=ripetizioni
# Identico a JITSI_JWT_APP_SECRET del gestionale. openssl rand -hex 32
JITSI_JWT_APP_SECRET=
# openssl rand -hex 16 (ciascuno)
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
# IP pubblico della VPS
JVB_ADVERTISE_IPS=
# Fissare una versione stabile (es. stable-XXXXX da hub.docker.com/r/jitsi/web/tags) in produzione.
JITSI_IMAGE_VERSION=stable
