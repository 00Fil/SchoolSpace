# Credenziali del ruolo app_migrator (DDL), usate solo dal job "migrate" (infra/postgres/README.md).
# app_migrator è NOINHERIT: libpq esegue SET ROLE app_owner all'apertura della connessione,
# così le tabelle create appartengono al proprietario e non al login.
POSTGRES_USER=app_migrator
POSTGRES_PASSWORD=<dal-secret-manager>
PGOPTIONS=-c role=app_owner
