# Modello delle variabili di produzione. I valori reali stanno SOLO nel secret manager
# e sono materializzati in infra/env/production.env dal deploy (file escluso da git).
DEPLOY_ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=config.settings_production
DJANGO_SECRET_KEY=<dal-secret-manager-almeno-50-caratteri>
DJANGO_ALLOWED_HOSTS=localhost/
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost/
DJANGO_HSTS_SECONDS=3600
PORTAL_BASE_URL=http://localhost/
# Admin Django spento in produzione (GAP-I06); se acceso serve l'allowlist.
DJANGO_ADMIN_ENABLED=0
# DJANGO_ADMIN_ALLOWED_NETWORKS=203.0.113.0/28
CSP_REPORT_ONLY=0
TRUSTED_PROXY_HOPS=1
# PostgreSQL 17 gestito, rete privata, TLS verify-full, ruolo runtime senza DDL.
POSTGRES_DB=ripetizioni
POSTGRES_USER=app_runtime
POSTGRES_PASSWORD=<dal-secret-manager>
DB_HOST=pg-ripetizioni.private.example.internal
DB_PORT=5432
DB_SSLMODE=verify-full
# DB_SSLROOTCERT è impostata da compose.prod.yaml (/run/secrets/pg_ca, CA del provider).
# Redis privato AUTH (utente ACL "app") + TLS.
CACHE_URL=rediss://app:<password>@redis:6380/1
CELERY_BROKER_URL=rediss://app:<password>@redis:6380/0
OPS_METRICS_TOKEN=<dal-secret-manager>
OPS_WORKER_QUEUES=solver,notifications,default
OPS_BACKUP_STATUS_FILE=
LOG_LEVEL=INFO
LOG_FORMAT=json
# I flag EXPERIMENTAL_* sono vietati da config.settings_production (anche in staging).
# Segreti anche come file: DJANGO_SECRET_KEY_FILE, POSTGRES_PASSWORD_FILE, CACHE_URL_FILE, ...

# --- P1-P6: regole del centro (vedi docs/CONFIGURAZIONE.md) ---
DJANGO_CSRF_TRUSTED_ORIGINS=https://gestionale.example.it
RECOVERY_NOTICE_HOURS=24
PRIVACY_NOTICE_VERSION=2026-10
TUTOR_CHANGES_REQUIRE_GUARDIANS=1
PORTAL_STUDENT_CAN_REQUEST_CHANGES=0
PRIVACY_MAJORITY_OVERDUE_ACTION=REPORT

# --- Email (SMTP) ---
# Senza questo blocco il backend resta "sink" e nessuna email parte.
COMMUNICATIONS_ENV=production
COMMUNICATIONS_CHANNELS=IN_APP,EMAIL
# D08: Resend. Dominio mittente da verificare su Resend (SPF/DKIM).
COMMUNICATIONS_EMAIL_BACKEND=resend
# Chiave API Resend (permesso "Sending access"), dal secret manager:
COMMUNICATIONS_RESEND_API_KEY=<chiave-resend>
CALENDAR_HORIZON_MODE=MONTH
CALENDAR_REQUIRE_EXPLICIT_VALIDATION=1
PORTAL_STUDENT_CAN_REQUEST_CHANGES=0
COMMUNICATIONS_EMAIL_FROM=Centro ripetizioni <no-reply@example.it>
COMMUNICATIONS_MESSAGE_ID_DOMAIN=example.it
COMMUNICATIONS_SMTP_HOST=smtp.example.it
# 587 + starttls, oppure 465 + tls
COMMUNICATIONS_SMTP_PORT=587
COMMUNICATIONS_SMTP_SECURITY=starttls
COMMUNICATIONS_SMTP_USER=<utente-smtp>
# Password: come valore OPPURE come file (mai entrambe):
# COMMUNICATIONS_SMTP_PASSWORD=<dal-secret-manager>
COMMUNICATIONS_SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# v0.9.4 — calcolo accurato dell'orario (profilo THOROUGH, es. notturno)
# PLANNING_THOROUGH_BUDGET_SECONDS=21600
# PLANNING_THOROUGH_WORKERS=4
# PLANNING_THOROUGH_QUEUE=solver_long
