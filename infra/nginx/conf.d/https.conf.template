# Porta 8443 (pubblicata come 443): TLS 1.2/1.3, OCSP stapling, HSTS.
server {
  listen 8443 ssl default_server;
  http2 on;
  server_name __SERVER_NAME__;
  location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }
  set $forwarded_proto https;

  ssl_certificate     __TLS_CERT__;
  ssl_certificate_key __TLS_KEY__;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:TLS:10m;
  ssl_session_tickets off;
  ssl_stapling on;
  ssl_stapling_verify on;
  resolver 1.1.1.1 9.9.9.9 valid=300s;
  resolver_timeout 5s;

  include /etc/nginx/snippets/app-locations.conf;
}
